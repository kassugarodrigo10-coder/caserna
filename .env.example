# Necessário só para o login da Diretoria (o resto do site funciona sem isso).
# Crie um projeto gratuito em https://supabase.com, rode supabase/schema.sql no SQL editor,
# e copie as chaves em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — nunca expor no cliente, usada só na rota /api/diretoria/signup.
SUPABASE_SERVICE_ROLE_KEY=
